# LANDY Creator — environment variables
#
# Copy this file to .env and fill in values for local development.
# Never commit .env to version control.
# All variables documented here must be set in production.

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL 15+ connection string with pgvector extension enabled.
# For docker-compose local dev: postgresql://landy:landy@db:5432/landy
# For Replit dev: provided automatically by Replit
DATABASE_URL=postgresql://landy:landy@localhost:5432/landy

# ── Sessions ──────────────────────────────────────────────────────────────────
# Long random string used to sign session tokens. Generate with:
#   python -c "import secrets; print(secrets.token_hex(64))"
SESSION_SECRET=change-me-use-python-secrets-token-hex-64

# Session lifetime in hours (default 720 = 30 days)
SESSION_TTL_HOURS=720

# ── Object storage (S3-compatible) ────────────────────────────────────────────
# Supports: MinIO (local dev), AWS S3, IDCloudHost IS3, Biznet Gio NEO.
# Change only S3_ENDPOINT_URL to switch providers; the rest of the code
# is provider-agnostic.

# For local dev with docker-compose MinIO:
S3_ENDPOINT_URL=http://localhost:9000
# For AWS S3: leave blank or set to https://s3.amazonaws.com
# For IDCloudHost IS3: https://is3.cloudhost.id
# For Biznet Gio NEO: https://s3.neolynk.id

S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# Class B bucket — user-uploaded contracts (personal data)
# Separate from any future Class A bucket for the statute corpus
S3_BUCKET_CLASS_B=landy-contracts

# ── LLM provider ──────────────────────────────────────────────────────────────
# REQUIRED — the app refuses to start (both the API and the worker) if no
# provider is configured. There is no fallback provider.
#
# Contract text is uploaded by Indonesian creators and may carry counterparty
# PII (see landy/redaction.py — redaction reduces but does not eliminate this
# exposure). Before pointing LLM_BASE_URL/LLM_PROVIDER at any endpoint,
# confirm with the provider/vendor and record for this deployment:
#   - No-training guarantee: the provider does not train on API inputs.
#   - Zero or short data retention for API requests (get the actual window).
#   - A known data-processing region (relevant for UU PDP cross-border
#     transfer analysis).
# This is a procurement/legal decision, not something the code enforces.
#
# Provider identifier — one of: "openai", "openrouter", "compatible",
# "azure_compat". Any OpenAI-compatible endpoint (including compatibility
# proxies for other model vendors) works via "compatible" + LLM_BASE_URL.
LLM_PROVIDER=openai

# API key for the LLM provider
LLM_API_KEY=

# Model to use for analysis calls — must be a real, currently-available
# model id for the configured provider.
LLM_MODEL=gpt-4o

# Optional: custom base URL for OpenAI-compatible providers.
# Leave blank for official OpenAI.
LLM_BASE_URL=

# ── Admin ─────────────────────────────────────────────────────────────────────
# Secret required by the admin CLI (python -m landy.admin ...).
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
ADMIN_SECRET=change-me-in-production

# ── Retention ─────────────────────────────────────────────────────────────────
# Number of days after soft-delete before blobs and rows are hard-deleted.
RETENTION_DAYS=30

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins, or * for dev.
# In production, set to your frontend domain(s).
CORS_ORIGINS=*

# ── Quota ─────────────────────────────────────────────────────────────────────
# Default analyses quota assigned to new users (overridable per-user in DB).
DEFAULT_ANALYSES_QUOTA=8
